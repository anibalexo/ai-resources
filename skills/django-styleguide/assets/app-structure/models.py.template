from django.core.exceptions import ValidationError
from django.db import models
from django.db.models import F, Q
from django.utils import timezone


class BaseModel(models.Model):
    """
    Abstract base model providing indexed creation and automatic update timestamps.
    """
    created_at = models.DateTimeField(db_index=True, default=timezone.now)
    updated_at = models.DateTimeField(auto_now=True)

    class Meta:
        abstract = True


class ExampleItem(BaseModel):
    """
    Example domain model with constraints and validation.
    """
    title = models.CharField(max_length=255)
    description = models.TextField(blank=True, default="")
    is_active = models.BooleanField(default=True)
    start_date = models.DateField()
    end_date = models.DateField()

    class Meta:
        constraints = [
            models.UniqueConstraint(
                fields=["title"],
                name="unique_example_item_title"
            ),
            models.CheckConstraint(
                name="example_item_start_before_end",
                check=Q(start_date__lt=F("end_date"))
            ),
        ]

    def __str__(self) -> str:
        return self.title

    def clean(self) -> None:
        super().clean()
        if self.start_date and self.end_date and self.start_date >= self.end_date:
            raise ValidationError({"end_date": "End date must be strictly after start date."})
