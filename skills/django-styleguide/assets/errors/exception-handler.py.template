from django.core.exceptions import ValidationError as DjangoValidationError
from rest_framework import exceptions, status
from rest_framework.response import Response
from rest_framework.views import exception_handler


class ApplicationError(Exception):
    """
    Base domain exception for business logic rule violations.
    """
    def __init__(self, message: str, extra: dict | None = None):
        super().__init__(message)
        self.message = message
        self.extra = extra or {}


def custom_exception_handler(exc, context):
    """
    Centralized exception handler producing standardized JSON payloads:
    {
        "message": "...",
        "extra": {...}
    }
    """
    # 1. Handle ApplicationError (Domain rule violations)
    if isinstance(exc, ApplicationError):
        data = {
            "message": exc.message,
            "extra": exc.extra,
        }
        return Response(data, status=status.HTTP_400_BAD_REQUEST)

    # 2. Handle Django's built-in ValidationError
    if isinstance(exc, DjangoValidationError):
        if hasattr(exc, "message_dict"):
            extra = {"fields": exc.message_dict}
            message = "Validation error."
        elif hasattr(exc, "messages"):
            extra = {"non_field_errors": exc.messages}
            message = "Validation error."
        else:
            extra = {}
            message = str(exc)

        data = {
            "message": message,
            "extra": extra,
        }
        return Response(data, status=status.HTTP_400_BAD_REQUEST)

    # 3. Call DRF's default exception handler first to get the standard response
    response = exception_handler(exc, context)

    # 4. If DRF handled it, standardize the response format
    if response is not None:
        if isinstance(exc, exceptions.ValidationError):
            data = {
                "message": "Validation error.",
                "extra": {"fields": response.data if isinstance(response.data, dict) else {"non_field_errors": response.data}},
            }
            response.data = data
        else:
            detail = response.data.get("detail", str(exc)) if isinstance(response.data, dict) else str(exc)
            response.data = {
                "message": str(detail),
                "extra": {},
            }

    return response
